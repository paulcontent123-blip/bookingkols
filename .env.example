NODE_ENV=development
PORT=3000
# Địa chỉ website khi chạy thật (dùng cho sitemap, thẻ SEO, liên kết).
APP_URL=http://localhost:3000

# Supabase: khoá service role chỉ dùng phía máy chủ, không bao giờ gửi xuống trình duyệt.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Chuỗi kết nối PostgreSQL (chỉ cần khi chạy `npm run db:migrate` để tạo bảng; có thể xoá dòng này sau đó).
# Supabase -> Connect -> Session pooler -> URI, thay [YOUR-PASSWORD] bằng mật khẩu database.
SUPABASE_DB_URL=

# Cloudinary (ảnh bài viết tải lên từ trang quản trị)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Thư mục chứa ảnh tải lên; ảnh giao diện nằm ở bookingkol/site-assets (không đụng tới).
CLOUDINARY_FOLDER=bookingkol/images

# Đăng nhập quản trị: chuỗi bí mật dài, ngẫu nhiên (dùng để ký phiên đăng nhập).
JWT_SECRET=replace-with-a-long-random-secret

# Gửi email khi có khách để lại liên hệ (để trống thì chỉ lưu vào database).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_DISPLAY_NAME=Booking KOLs
# Người nhận thông báo liên hệ.
CONTACT_RECEIVER=

# Google Tag Manager (GA4 được gắn qua GTM) và xác minh Google Search Console.
GTM_ID=GTM-KP2KXTQB
GOOGLE_SITE_VERIFICATION=9qDCBzEZ36xZWpacyClnjvGMmqYnMK36Fa6mzAKlMb8
